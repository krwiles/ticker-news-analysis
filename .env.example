# Copy to .env for local development — docker-compose reads this file automatically.
POSTGRES_USER=ticker
POSTGRES_DB=ticker
# SEC requires a descriptive User-Agent identifying the app + a contact email — not a secret, just compliance.
SEC_EDGAR_USER_AGENT=YourAppName your-email@example.com
# Secrets (the Postgres password, FINNHUB_API_KEY, OPENAI_API_KEY) do NOT live in this file -- run
# scripts/init-secrets.sh, which writes them to ./secrets/ (ADR 0017). It also maintains this flag:
# SENTIMENT_CONFIGURED=true|false (whether an OpenAI key exists, so the api container can skip sentiment
# without ever holding the key).
# OAuth 2.0 Client ID (Web application type) from Google Cloud Console -- not a secret (ADR 0016:
# GIS's credential flow never exchanges a client secret at all). See docs/plans/0037-*.md step 1.
GOOGLE_CLIENT_ID=
# Milvus standalone's MinIO sidecar -- local-dev-only credentials, the well-known Milvus default.
MILVUS_MINIO_ACCESS_KEY=minioadmin
MILVUS_MINIO_SECRET_KEY=minioadmin
# dbmate's own connection string (host-side, plain postgres:// -- the containers build their own URL from
# the Postgres secret). Local-dev only: its password must match ./secrets/postgres_password.
DATABASE_URL=postgres://ticker:ticker@localhost:5432/ticker?sslmode=disable
# A separate database for the test suite (ADR 0005) -- migrated by the same dbmate files as dev, never shares
# data with it.
TEST_DATABASE_URL=postgres://ticker:ticker@localhost:5432/ticker_test?sslmode=disable
