# Copy to .env for local development — docker-compose reads this file automatically.
POSTGRES_USER=ticker
POSTGRES_PASSWORD=ticker
POSTGRES_DB=ticker
# SEC requires a descriptive User-Agent identifying the app + a contact email — not a secret, just compliance.
SEC_EDGAR_USER_AGENT=YourAppName your-email@example.com
# Free API key from finnhub.io — sign up, copy it from your dashboard.
FINNHUB_API_KEY=
# API key from platform.openai.com — used for spec 0002's embedding calls (Daily Story Grouping, Arc 4).
# Not free, but trivially cheap at this project's volume (fractions of a cent/month, per Arc 4's own research).
OPENAI_API_KEY=
# dbmate's own connection string (host-side, plain postgres:// — different from the app's asyncpg:// URL,
# which docker-compose sets directly for containers and doesn't come from this file).
DATABASE_URL=postgres://ticker:ticker@localhost:5432/ticker?sslmode=disable
# A separate database for the test suite (ADR 0005) -- migrated by the same dbmate files as dev, never shares
# data with it.
TEST_DATABASE_URL=postgres://ticker:ticker@localhost:5432/ticker_test?sslmode=disable
